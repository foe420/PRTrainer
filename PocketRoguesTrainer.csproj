<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PocketRoguesTrainer</AssemblyName>
    <RootNamespace>PocketRoguesTrainer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <!-- Game assemblies were built against Unity's own mscorlib; warnings about
         facade version differences are harmless here. -->
    <NoWarn>$(NoWarn);MSB3277;CS1701;CS1702</NoWarn>

    <!-- Game install with BepInEx 5 in it. Override if yours is elsewhere:
         dotnet build -c Release -p:GameDir="D:\Games\Pocket Rogues" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pocket Rogues</GameDir>
    <ManagedDir>$(GameDir)\Pocket Rogues_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />

    <!-- Every game/Unity assembly except the framework ones (those come from the
         .NET Framework 4.8 reference pack). Needed so the compiler can resolve
         the full base-type chain of game classes such as Character. -->
    <Reference Include="$(ManagedDir)\*.dll"
               Exclude="$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\System.dll;$(ManagedDir)\System.*.dll;$(ManagedDir)\Mono.Security.dll"
               Private="false" />
  </ItemGroup>

</Project>
